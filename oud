      <a href="#" target="_blank" rel="noopener">TikTok</a>
    </div>
  </div>
</section>

<footer>
  <div class="wrap" style="display:flex; justify-content:space-between; width:100%; flex-wrap:wrap; gap:10px;">
    <span>IT'Z is een alcoholvrije wijn van wijnhuis Leitz.</span>
    <span>Alle IT'Z-wijnen zijn 0.0% alcohol.</span>
  </div>
</footer>

</body>
</html>
